{
  "name": "breachmap",
  "version": "0.1.0",
  "description": "Turn a security incident into a sourced, interactive attack map: one offline HTML file.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "breachmap": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "esbuild src/bin.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/cli.js --banner:js=\"#!/usr/bin/env node\"",
    "test": "vitest run"
  },
  "devDependencies": {
    "@breachmap/core": "workspace:*",
    "@breachmap/render": "workspace:*",
    "@breachmap/schema": "workspace:*",
    "esbuild": "^0.28.2"
  }
}
