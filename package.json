{
  "name": "breachmap-workspace",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "author": "Shuja",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shujaSN/BreachMap.git"
  },
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "lint": "biome check .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "check:arch": "node scripts/check-arch.ts",
    "check": "pnpm lint && pnpm typecheck && vitest run --coverage && pnpm check:arch",
    "breachmap": "node packages/cli/src/bin.ts",
    "eval:score": "node evals/score.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
